# AI Avatar Video Pipeline - Environment Variables
# Copy this file to .env and fill in your API keys

# LLM for script generation (pick one)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Text-to-Speech
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# AI Avatar
HEYGEN_API_KEY=your_heygen_api_key_here
HEYGEN_AVATAR_ID=your_avatar_id_here

# AI Video Generation (B-Roll)
RUNWAY_API_KEY=your_runway_api_key_here

# Optional: Anthropic model override
LLM_PROVIDER=anthropic  # or "openai"
LLM_MODEL=claude-sonnet-4-6  # or "gpt-4o"
